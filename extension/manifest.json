{
    "manifest_version": 3,
    "name": "Sensitive Info Checker",
    "version": "0.5",
    "description": "Warns the user before accidentally sending sensitive information to AI chatbots",
    "permissions": ["storage"],
    "action": {
        "default_popup": "popup.html"
    },
    "content_scripts": [
        {
            "matches": [
                "https://chatgpt.com/*",
                "https://claude.ai/*",
                "https://gemini.google.com/*",
                "https://grok.com/*"
            ],
            "js": ["rules.js", "content.js"],
            "css": ["content.css"]
        }
    ]
}
